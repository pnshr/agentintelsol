{
  "name": "agentintel-broker-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Backend skeleton for AgentIntel Broker autonomous Solana intelligence agent.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:adapters": "tsx src/scripts/demoAdapters.ts",
    "demo:workflow": "tsx src/scripts/demoWorkflow.ts",
    "demo:run": "tsx src/scripts/runDemoWorkflow.ts",
    "demo:synapse-real": "tsx src/scripts/runSynapseRealWorkflow.ts",
    "demo:seed": "tsx src/scripts/seedDemoData.ts",
    "sap:check": "tsx src/scripts/checkSapSdkAccess.ts",
    "sap:discovery": "tsx src/scripts/checkSapDiscovery.ts",
    "sap:register": "tsx src/scripts/registerSapAgent.ts",
    "ace:check": "tsx src/scripts/checkAceX402Access.ts",
    "ace:orders": "tsx src/scripts/listAceOrders.ts",
    "sentinel:check": "tsx src/scripts/checkSentinelAccess.ts",
    "sentinel:escrow": "tsx src/scripts/openSentinelEscrow.ts",
    "db:reset": "tsx src/scripts/resetLocalDatabase.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@oobe-protocol-labs/synapse-sap-sdk": "^0.18.0",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pino": "^9.6.0",
    "viem": "^2.51.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
